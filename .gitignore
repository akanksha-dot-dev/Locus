# ==============================================================================
# SwytchAgent Day Planner v2.0 — Unified Repository .gitignore
# Track 5: AI Real World Agent | Build with Swytchcode Hackathon 2026
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ── Python & Virtual Environments ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/venv/
backend/.venv/
**/venv/
**/__pycache__/

# ── Node & Frontend Artifacts ─────────────────────────────────────────────────
node_modules/
frontend/node_modules/
**/node_modules/
dist/
frontend/dist/
**/dist/
.vite/
frontend/.vite/
**/coverage/

# ── Swytchcode Credentials & Local DBs ────────────────────────────────────────
.swytchcode/
**/.swytchcode/
backend/.swytchcode/
*.db
*.sqlite3

# ── Runtime State & Service Logs ──────────────────────────────────────────────
.running_pids
backend/.running_pids
*.log
*.log.*
server.log
dashboard.log
server_err.log
dashboard_err.log
backend/*.log

# ── IDE, OS & Editor Caches ───────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── Reference & Internal Metadata ─────────────────────────────────────────────
.agents/
hackathon-playbook/
.swytchcode/workspace.json
