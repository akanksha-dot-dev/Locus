# =============================================================
# WeatherWise AI Life Agent - Environment Variables
# Track 5: AI Real World Agent | Build with Swytchcode
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM Provider (Google Gemini) ---
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-lite-latest

# --- OpenWeather API ---
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
DEFAULT_CITY=Mumbai

# --- Notion (Daily Intelligence Log) ---
NOTION_KB_DATABASE_ID=your_notion_database_id_here
NOTION_API_KEY=your_notion_api_key_here

# --- Slack ---
# Option A: Incoming Webhook (simpler)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Option B: Bot Token (Swytchcode integration)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#weather-alerts

# --- Resend (Email Digest) ---
# Get key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=your_email@example.com

# --- Gmail (via Swytchcode) ---
GMAIL_MAX_EMAILS=10

# --- Agent Settings ---
MAX_EMAILS_PER_RUN=10

# --- Swytchcode Native Binary ---
# SWYTCHCODE_BIN=C:\Users\YourName\AppData\Roaming\npm\node_modules\swytchcode\...
