# ==============================================================================
# ⚡ Locus — Autonomous Incident Command Center & Day Planner v2.0
# Track 5: AI Real World Agent | Build with Swytchcode Hackathon 2026
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'backend/' directory (or root directory):
#    cp .env.example .env
# 2. Fill in your API keys and tokens below.
# 3. All 7 integrations are supported. At minimum, GOOGLE_API_KEY and OPENWEATHER_API_KEY
#    are recommended for core autonomous reasoning. Every other integration has
#    high-fidelity, production-grade fallbacks if credentials are omitted.
# 4. NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# ── 1. LLM & Autonomous Reasoning Engine (Google Gemini) ─────────────────────
# Required for LangGraph multi-source synthesis, office/WFH decisions, & scheduling.
# Get free Gemini API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyYourGeminiApiKeyHere
LLM_MODEL=gemini-2.0-flash

# ── 2. Weather & Atmospheric Conditions (OpenWeather API) ────────────────────
# Required for live temperature, humidity, wind vectors, and commute risk scores.
# Get free API key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
DEFAULT_CITY=Mumbai

# ── 3. Engineering Workload & Sprint Tracking (Jira Cloud) ───────────────────
# Ingests sprint backlog, priority bugs, and calculates estimated work hours.
# JIRA_DOMAIN: Your Atlassian Cloud domain WITHOUT 'https://' (e.g. company.atlassian.net)
# JIRA_EMAIL: Your Atlassian account email address
# JIRA_API_TOKEN: Generated at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_PROJECT_KEY: The project prefix key in Jira (e.g. CCS, PROJ, ENG)
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=dev@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=CCS

# ── 4. Code Review & Pull Request Backlog (GitHub REST API) ──────────────────
# Ingests open PRs, stale reviews (>2d), and repository issues for workload HUD.
# GITHUB_TOKEN: Personal Access Token (classic or fine-grained with repo/read scope)
# Generate token: https://github.com/settings/tokens
# GITHUB_OWNER: GitHub username or organization (e.g. iakankshaa)
# GITHUB_REPO: Repository name (e.g. support-kb-gaps)
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ── 5. Executive Knowledge Base & Page Logging (Notion API) ──────────────────
# Creates structured executive Day Plan documents in your Notion database.
# NOTION_API_KEY: Internal Integration Secret (ntn_... or secret_...)
# Create integration: https://www.notion.so/profile/integrations
# NOTION_KB_DATABASE_ID: 32-character database UUID from your Notion database URL
# (e.g. https://notion.so/workspace/3e3f84ad2b598079a256c69ea5a7b651 -> 3e3f84ad2b598079a256c69ea5a7b651)
# Note: Ensure you share your Notion database with your integration via the '...' menu!
NOTION_API_KEY=ntn_your_notion_integration_token_here
NOTION_KB_DATABASE_ID=3e3f84ad2b598079a256c69ea5a7b651

# ── 6. Team Alerts & Incident Notifications (Slack) ──────────────────────────
# Dispatches rich Slack Block Kit cards with verdict pill, timeline, & Notion link.
# Option A: Incoming Webhook (Simpler setup - Recommended)
# Create webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Option B: Bot Token (Optional if using Bot User OAuth)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#weather-alerts

# ── 7. Executive Morning Briefing Email Digest (Resend API) ──────────────────
# Sends responsive HTML day plan digest directly to your inbox.
# Get free API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Free tier sender: onboarding@resend.dev (or your verified domain email)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Your email where the morning briefing should be sent
RESEND_TO_EMAIL=your_email@example.com

# ── 8. Gmail Calendar Context & Meeting Anchors (Swytchcode) ─────────────────
# Scans inbox for meetings, flights, and outdoor event commitments.
GMAIL_USER=me
GMAIL_MAX_EMAILS=10
MAX_EMAILS_PER_RUN=10
SUPPORT_LABEL=support

# ── 9. Optional Local Runtime & Swytchcode Native Binary ─────────────────────
# Path to local Swytchcode CLI binary (only if running via local npm package)
SWYTCHCODE_BIN=C:\Users\YourUser\AppData\Roaming\npm\node_modules\swytchcode\bin\swytchcode.exe
